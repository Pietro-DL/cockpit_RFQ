# Documenti e specifiche riservate
docs/
specs/
# I piani vivono nell'archivio privato: se qualcuno li copia qui per comodità, non finiscono
# comunque in un commit. Il riepilogo pubblicabile di ogni fase è cockpit/FASE_N.md.
PIANO_*.md

# Directory di filesystem locali e sandbox
_staging/
_staging_worker/
_nas_test/
staging/
# ...ma `cockpit/internal/platform/storage/staging/` e' un package Go, non una cartella di
# lavoro. La riga qui sopra non e' ancorata e se lo mangiava in silenzio: `git mv` stagia i file
# esplicitamente e passavano, un file NUOVO no. Tre file di B5 sono rimasti fuori dai commit.
!cockpit/internal/platform/storage/staging/

# File di configurazione con credenziali e token (usare i relativi *.example)
cockpit.toml
worker.toml
*.local.toml
.env
.env.*
cookies.txt

# Binari e compilati
*.exe
*.exe~
*.dll
*.so
*.dylib

# Log
*.log

# Python cache e test
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# Editor e OS
.vscode/
.idea/
Thumbs.db
Desktop.ini
.DS_Store
*.swp
*.tmp
