# Gli script bash girano anche su Windows (Git Bash) e su Linux: con core.autocrlf un checkout su
# Windows li riscriverebbe con CRLF, e bash si fermerebbe alla prima riga («$'\r': command not found»).
*.sh text eol=lf

# pdf.js e' copiato com'e' dal pacchetto pdfjs-dist: nessuna conversione dei fine riga (i moduli minificati
# contengono template literal, e un CRLF li cambierebbe).
web/static/pdfjs-*/** -text

# Gli ingressi e i golden degli adattatori del motore A (giro 5, A1b): il contenuto non dipende dai fine riga
# (i CRLF dei casi stanno dentro le stringhe JSON come \r\n), ma i file restano LF anche su Windows, così il diff
# dei golden è lo stesso su ogni postazione.
internal/core/estrazione/testdata/** text eol=lf

# I casi del Motore A (valutazione, pagina web): le prove confrontano i byte del JSON con quelli del costruttore e con
# il file dei casi letto in modo stretto; con core.autocrlf un checkout su Windows li riscriverebbe con CRLF e le prove
# fallirebbero su una postazione pulita (notte del 14/10).
internal/core/valutazione/testdata/** text eol=lf
internal/transport/web/testdata/** text eol=lf
