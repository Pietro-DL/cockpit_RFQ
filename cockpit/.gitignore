# File di configurazione con credenziali
cockpit.toml
cockpit.*.toml
workers/worker.toml
# Il pacchetto della postazione, scompattato sul banco: worker.toml con i token, istruzioni
# con l'indirizzo del server. Lo genera il server (D22), non il repository.
workers/ISTRUZIONI.txt
workers/cockpit-worker-*/
*.local.toml
.env
.env.*

# Binari
cockpit.exe
*.exe
*.exe~

# Log e staging
*.log
/staging/
cookies.txt

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Editor
.vscode/
.idea/

# Documenti e corpus riservati: vivono nella radice del repository, non qui
docs/
specs/
_staging/
_nas_test/

# I test Go non vanno nel repository pubblico: qui restano i file del prodotto.
#
# Restano nell'albero di lavoro (questa riga li nasconde a git, non li cancella) e restano nella
# storia fino al commit che li ha tolti dall'indice: per rimetterli dentro basta revertire quel
# commit. Chi lavora sul codice li ha; chi legge il repository vede il prodotto.
#
# Attenzione: da qui in avanti un checkout pulito NON puo' eseguire L1, L4 e L7. Le prove si fanno
# nell'albero di lavoro di chi sviluppa.
*_test.go

# Certificati e chiavi generati dal server (scripts/avvio-rete: tls/lan/, tls/https/). La chiave privata
# non esce da questo PC.
tls/
*.pem
