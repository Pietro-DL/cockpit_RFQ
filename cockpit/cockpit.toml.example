# Configurazione di esempio per Cockpit RFQ
# Copiare questo file in cockpit.toml e compilare i campi richiesti.
# I percorsi Windows vanno in stringhe letterali TOML ('...'), così i backslash non richiedono escape.
#
# ============================================================================
# COME SI PARTE, in ordine
# ============================================================================
#
#  1. [db].dsn, [nas].radice e [nas].staging: cartelle che esistono, database che risponde.
#  2. [[utenti]]: chi entra e con quale `ruolo` (operatore | admin | tecnico | consultazione).
#     Almeno uno deve essere `admin`: il pacchetto dei worker, la coda dei job e gli scarti sono
#     schermate sue, e un operatore che ci prova riceve 403. `password` serve solo al primo avvio.
#  3. [[casella]], [[postazione]], [[worker]]: chi c'è e chi serve che cosa. È QUI che si dichiarano
#     le autorizzazioni, non in una schermata: questo file è versionato e uguale a ogni avvio.
#  4. Nei [[worker]] lasciare `token = ""`. Vuol dire «il segreto lo tiene il database», ed è la via
#     consigliata: il seed non lo tocca più, e al primo avvio quelle credenziali risultano «da
#     generare» (il server lo scrive nel log e la pagina Postazioni lo mostra in cima).
#  5. Avviare il server, aprire **Postazioni**, premere «genera e scarica il pacchetto» per ogni PC.
#     Lo zip contiene un worker.toml già pronto — indirizzo, impronta del certificato, un token
#     DIVERSO per ogni worker di quel PC — più i file del worker.
#  6. Scompattare il pacchetto sul PC, in `workers\`, e avviare i worker.
#
# SE SI ARRIVA DA UN TOKEN CONDIVISO (un solo segreto copiato in tutti i [[worker]]): svuotare i
# `token` qui è la mossa giusta ma NON basta, perché il seed non riscrive un token che il file non
# dichiara — le impronte duplicate restano in database e i worker continuano a ricevere 401. Serve
# il passo 5: «Rigenera credenziali della postazione». La pagina Postazioni segnala da sola quali PC
# sono in quello stato.

[server]
# In sviluppo: 127.0.0.1:8080, e basta. Fuori da questo PC (VM, banco a due PC) il server si RIFIUTA
# di partire in chiaro: di qui passano la posta dell'azienda, i token dei worker e il cookie di
# sessione dell'operatore, e su una LAN in chiaro li legge chiunque senza che niente lo segnali.
indirizzo = "127.0.0.1:8080"
# indirizzo = "0.0.0.0:8443"
#
# TLS (voce 2.4). Se i due file NON esistono, il server ne genera uno autofirmato al primo avvio e
# scrive l'impronta sha256 nel log e nella pagina Postazioni: è quella che i worker mettono in
# worker.toml, e da quel momento parlano solo con questo server. Percorsi relativi a questo file.
# tls_cert = 'tls/cert.pem'
# tls_key  = 'tls/key.pem'
# I nomi per cui vale il certificato generato (SAN): il nome della VM, il suo IP, gli alias con cui i
# worker la chiamano. Assente = nome host della macchina + l'indirizzo di ascolto se è un IP.
# tls_nomi = ["cockpit", "cockpit.azienda.local", "10.0.0.7"]
#
# Via d'uscita dichiarata: ascoltare in chiaro fuori da questo PC. Ha senso solo se il collegamento è
# già cifrato da qualcos'altro (un tunnel). Il server lo ripete a ogni avvio nel log.
# consenti_lan_in_chiaro = false
#
# token_worker NON autentica più niente (voce 2.4): ogni worker ha il suo token, qui sotto in
# [[worker]], e il server lo riconosce per sha256. Se la riga è ancora nel file, il server lo dice
# all'avvio: va tolta.
log_livello = "info" # debug | info | warn
# Come gira il server (voce 9.5, §2.7 del piano):
#   shadow      legge Outlook e il NAS, non li modifica. Niente bozze, niente «segna letto», niente
#               spostamenti di cartella, niente scritture sul NAS: quei job non si accodano e non si
#               eseguono nemmeno se sono già in coda. «Apri in Outlook» resta consentito (apre una
#               finestra e basta) e `dry_run` viene forzato a true. Serve a far girare il sistema
#               sulla posta vera senza che un difetto diventi una mail modificata;
#   produzione  tutto attivo. Al passaggio da shadow a produzione i job che avevano aspettato
#               vengono ANNULLATI: nulla parte a sorpresa. Le copie che servono si rimettono in coda
#               dal fascicolo.
# ASSENTE = shadow. Il default sicuro è quello che non tocca niente.
modalita = "shadow"
# Dove il server scrive il PROPRIO log, oltre che nella finestra da cui è stato avviato (5 file da
# 5 MB, come i worker). Assente = <nas.staging>\log\cockpit.log, cioè accanto a worker_outlook.log:
# la diagnosi di un job si fa leggendo le due metà una accanto all'altra. "-" = solo a schermo.
# log_file = '...\_staging\log\cockpit.log'
# Limite di un singolo allegato caricato dal worker (PUT /api/v1/allegati/{id}/file). Oltre, il server
# risponde 413 prima di ricevere il file e l'allegato compare in errore con il motivo. Default 64.
max_upload_mb = 64

[db]
dsn = "postgres://cockpit:INSERISCI_PASSWORD@localhost:5432/cockpit_dev"

[nas]
# La radice È la cartella "PREVENTIVI DA FARE": sotto nascono <cliente.cartella_nas>\WIP\<aaaa mm gg Cognome Oggetto>
radice = '...\_nas_test\PREVENTIVI DA FARE' # sandbox locale o UNC es. '\\nas01\TECNICO - PREVENTIVI\PREVENTIVI DA FARE'
dry_run = false                                      # true = calcola i percorsi senza scrivere
staging = '...\_staging'
# Le radici VERE, dichiarate una volta. Servono a una cosa sola: in shadow il server si RIFIUTA di
# partire se `radice` è una di queste (o una loro sottocartella). Una prova in shadow puntata sul NAS
# di produzione non è una shadow, è una prova sulla produzione con un badge rassicurante in testata.
radici_produzione = ['\\nas01\TECNICO - PREVENTIVI']

[outlook]
cartelle = ["Inbox", "Sent Items"]
# Ogni quanti secondi accodare un sync per casella. 0 = mai (solo «Aggiorna ora» e «Carica
# precedenti»). Con il `Restrict` della voce 2.9 un sync ordinario costa uno o due secondi, quindi
# 30 è sostenibile su quattro caselle; senza `Restrict` non lo sarebbe.
intervallo_sync_s = 30

# DA DOVE PARTE UN SYNC. La precedenza è una sola, per (casella, cartella):
#
#   1. il CURSORE di quella cartella, se c'è: vince sempre. Sta in database, quindi un riavvio del
#      server non riporta indietro nessuna casella;
#   2. `dal`, se scritto qui sotto: override esplicito, per un import controllato;
#   3. altrimenti la FINESTRA INIZIALE, cioè `adesso - giorni_sync_iniziale`.
#
# Sette giorni e non trenta perché il primo caricamento è l'unico momento in cui il worker scarica
# davvero tutto (corpo e allegati, non la sola enumerazione): su una casella viva un mese di archivio
# lo occupa per ore, e finché è occupato non apre elementi in Outlook e non scarica allegati per chi
# sta lavorando. L'archivio più vecchio si prende dopo, con «Carica precedenti»: due giorni per clic
# e per casella, così fra un pezzo e l'altro il worker torna disponibile.
giorni_sync_iniziale = 7

# Override esplicito della finestra iniziale, per import controllati. NON tocca le cartelle che hanno
# già un cursore: la posta di prima si prende con «Carica precedenti». Formato AAAA-MM-GG, letto nel
# fuso del server; scritto male, il server non parte. Lasciarlo scritto tiene ferma la finestra
# iniziale a quella data mentre i giorni passano.
# dal = "2026-08-01"

lotto = 50
consenti_invio = false
# Casella attribuita ai messaggi che non la dichiarano (fase 1, finché il contratto non porta
# casella_id). Con una sola [[casella]] si deduce da sola; con più di una è obbligatoria.
# Dalla fase 2 il lotto porta sempre il casella_id del job: questa resta il ripiego per un worker più
# vecchio del server, non il modo normale di attribuire la posta.
casella_default = "nome.cognome@azienda.it"

[retention]
# Per quanti giorni si tengono i job già chiusi. 0 = non cancellare nulla. Una coda che non si
# svuota mai diventa illeggibile e rallenta le pagine di amministrazione.
giorni_job = 30

[analisi]
# CON CHE COSA si analizza (fase 1, voce 1.12). Versione e sha256 di [analisi.parametri] formano,
# insieme allo sha256 del file, la chiave sotto cui i fatti vengono conservati e riusati: lo stesso
# disegno in tre RFQ fa partire una sola analisi. Cambiare un termine qui basta a far rianalizzare
# tutto, senza toccare il codice — ed è il motivo per cui i parametri stanno qui e non nel worker.
versione = 1

[analisi.parametri]
# I termini restano oggi dentro worker_analisi.py: qui si dichiara la configurazione che identifica
# l'analisi. Il worker li riceve e li rimanda indietro; usarli davvero è lavoro della fase 5.
termini_cartiglio = ["scala", "materiale", "tolleranze", "trattamento"]

# ---------------------------------------------------------------------------
# UTENTI (voce 6.9): chi entra e che cosa può fare.
#
# Le autorizzazioni dipendono da `ruolo`, e SOLO da quello. `ufficio` è organigramma: non dà e non
# toglie niente. La `sigla` nemmeno — un permesso legato alla sigla è un permesso che si eredita
# insieme alla scrivania.
#
#   operatore      l'interfaccia di lavoro: Inbox, Cruscotto, messaggi e thread, triage, RFQ,
#                  allegati, «Aggiorna ora». È il ruolo di chi usa il Cockpit tutto il giorno.
#   admin          tutto quello dell'operatore PIÙ le schermate tecniche: Coda job, Scarti e
#                  Postazioni — quindi anche la generazione del pacchetto dei worker.
#   tecnico        oggi può esattamente quello che può l'operatore. Esiste da adesso perché le
#                  azioni della fattibilità e dell'albero, quando arriveranno, saranno sue: senza,
#                  fra un mese l'ufficio tecnico entrerebbe come «operatore» e poi andrebbe cambiato.
#   consultazione  sola lettura: vede ciò che il suo ruolo vede, e non preme nessun pulsante.
#
# Un ruolo scritto male NON diventa più `operatore` in silenzio: il server non parte, e dice quale
# utente e quali parole sono ammesse.
#
# SERVE ALMENO UN `admin`, perché il pacchetto dei worker (passo 5 qui sopra) lo genera solo lui.
# Senza nessuno che possa aprire Postazioni non si aggiunge più un PC — e se l'unico amministratore
# viene declassato a operatore, quella porta si chiude mentre tutto il resto continua a funzionare.
# Per questo il server NON PARTE se fra gli [[utenti]] non ce n'è nessuno con ruolo admin.
#
# `password` serve SOLO a far nascere l'utente. Appena in database c'è un hash valido il file non lo
# sostituisce più: riavviare con una password diversa scritta qui non la cambia, e il server lo
# scrive nel log invece di lasciare qualcuno a chiedersi perché non entra. Il cambio password si farà
# dalla schermata del profilo (voce 6.4). Una volta che l'utente esiste, questa riga si può togliere.

[[utenti]]
sigla = "FP"
nome = "Nome Cognome"
ufficio = "Commerciale"
ruolo = "operatore"
password = "INSERISCI_PASSWORD_INIZIALE"

[[utenti]]
sigla = "PS"
nome = "Nome Cognome"
ufficio = "IT"
ruolo = "admin"
password = "INSERISCI_PASSWORD_INIZIALE"

# ---------------------------------------------------------------------------
# Fondazioni (migrazione 0002): caselle, postazioni, worker.
# Seminate a ogni avvio in modo NON distruttivo: una riga tolta da qui non viene disattivata,
# viene solo segnalata nel log. Gli indirizzi sono normalizzati in minuscolo, i nomi host in
# maiuscolo: la stessa casella scritta in due modi resta una casella sola.
# ---------------------------------------------------------------------------

# Una casella condivisa Exchange NON ha proprietario: `utente` va lasciato fuori.
[[casella]]
indirizzo = "commerciale@azienda.it"
nome      = "Commerciale"
condivisa = true

# Una casella personale ha come proprietario la sigla di un utente dichiarato in [[utenti]].
# `attiva = false` la tiene censita ma fuori uso: è il modo di spegnerne una senza cancellarla.
# Dalla 0004 (fase 2) le caselle attive possono essere più di una: il cursore di sincronizzazione ha
# per chiave (casella, cartella), quindi ognuna avanza per conto proprio. Fino alla 0003 il cursore
# era per sola cartella e il server si rifiutava di partire con più di una casella attiva, perché due
# caselle si sarebbero sovrascritte il cursore a vicenda perdendo messaggi in silenzio.
[[casella]]
indirizzo = "nome.cognome@azienda.it"
nome      = "Nome Cognome"
utente    = "NC"

[[postazione]]
nome_host   = "PC-NOME"
descrizione = "portatile commerciale"
utente      = "NC"

# Un worker per postazione e per tipo. Il token sta solo qui: nel database finisce il suo sha256.
# `caselle` è l'autorizzazione: il server interseca con quello che il worker dichiara al claim.
#
# DUE WORKER NON POSSONO AVERE LO STESSO TOKEN (voce 2.4). Dal blocco 2 il token non autorizza
# soltanto: identifica. Se lo stesso segreto è di due righe, il server non sa chi sta chiamando e
# risponde 401 nominando tutti e due.
#
# `token` vuoto (o riga assente) significa: «il segreto lo genera la pagina Postazioni». È la via
# consigliata — il pacchetto scaricato da lì contiene già indirizzo, impronta del certificato e
# token, e nessuno li copia a mano. Un token scritto qui invece vince a ogni avvio: è il file la
# verità, e va bene per il banco di prova.
#
# Svuotare un token NON cancella quello che c'è già in database: sarebbe il modo di far smettere di
# funzionare stanotte il pacchetto scaricato ieri. Per cambiare davvero un segreto si rigenera il
# pacchetto della postazione, e i token precedenti smettono di valere in quel momento.
[[worker]]
nome       = "outlook@PC-NOME"
tipo       = "outlook"
token      = ""
postazione = "PC-NOME"
caselle    = ["nome.cognome@azienda.it", "commerciale@azienda.it"]

[[worker]]
nome       = "analisi@PC-NOME"
tipo       = "analisi"
token      = ""
postazione = "PC-NOME"
