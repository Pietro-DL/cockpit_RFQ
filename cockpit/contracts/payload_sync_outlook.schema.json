{
  "$defs": {
    "CartellaCursore": {
      "description": "Una cartella da leggere con la SUA finestra, decisa dal server all'accodamento.\n\nIl worker non calcola piu' nessun limite: due cartelle della stessa casella possono essere a\npunti diversi (una sincronizzata da mesi, una aggiunta stamattina), e il limite di ciascuna\ndipende dalla sua copertura, non da quella della vicina.",
      "properties": {
        "cartella": {
          "title": "Cartella",
          "type": "string"
        },
        "dal": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dal"
        },
        "al": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Al"
        },
        "bootstrap": {
          "default": false,
          "title": "Bootstrap",
          "type": "boolean"
        },
        "ultimo_received": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ultimo Received"
        },
        "coperto_fino_a": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Coperto Fino A"
        }
      },
      "required": [
        "cartella"
      ],
      "title": "CartellaCursore",
      "type": "object"
    }
  },
  "properties": {
    "casella_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Casella Id"
    },
    "modo": {
      "default": "",
      "title": "Modo",
      "type": "string"
    },
    "cartelle": {
      "items": {
        "$ref": "#/$defs/CartellaCursore"
      },
      "title": "Cartelle",
      "type": "array"
    },
    "dal": {
      "format": "date-time",
      "title": "Dal",
      "type": "string"
    },
    "al": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Al"
    },
    "sovrapposizione_s": {
      "default": 600,
      "title": "Sovrapposizione S",
      "type": "integer"
    },
    "lotto": {
      "default": 50,
      "title": "Lotto",
      "type": "integer"
    }
  },
  "required": [
    "cartelle",
    "dal"
  ],
  "title": "PayloadSyncOutlook",
  "type": "object",
  "$id": "cockpit/payload_sync_outlook"
}
