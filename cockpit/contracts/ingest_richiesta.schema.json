    "saltati": {
      "items": {
        "$ref": "#/$defs/ElementoSaltato"
      },
      "title": "Saltati",
      "type": "array"
    }
  },
  "required": [
    "messaggi"
  ],
  "title": "IngestRichiesta",
  "type": "object",
  "$id": "cockpit/ingest_richiesta"
}
