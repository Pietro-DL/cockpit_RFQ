        "content_id": {
          "default": "",
          "title": "Content Id",
          "type": "string"
        }
      },
      "required": [
        "indice",
        "nome_file"
      ],
      "title": "AllegatoIn",
      "type": "object"
    },
    "CursoreLotto": {
      "description": "Fin dove arriva questo lotto. Il server lo scrive nella stessa transazione degli elementi:\no avanzano insieme o non avanza niente.",
      "properties": {
        "cartella": {
          "title": "Cartella",
          "type": "string"
        },
        "ultimo_received": {
          "format": "date-time",
          "title": "Ultimo Received",
          "type": "string"
        }
      },
      "required": [
        "cartella",
        "ultimo_received"
      ],
      "title": "CursoreLotto",
      "type": "object"
    },
    "Destinatario": {
      "properties": {
