{
  "$defs": {
    "AllegatoIn": {
      "properties": {
        "indice": {
          "title": "Indice",
          "type": "integer"
        },
        "nome_file": {
          "title": "Nome File",
          "type": "string"
        },
        "estensione": {
          "default": "",
