      },
      "title": "Messaggi",
      "type": "array"
    },
    "casella_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Casella Id"
    },
    "job_id": {
      "default": 0,
      "title": "Job Id",
      "type": "integer"
    },
    "lease_token": {
      "default": "",
      "title": "Lease Token",
      "type": "string"
    },
    "worker_id": {
      "default": "",
      "title": "Worker Id",
      "type": "string"
    },
    "cursore": {
      "anyOf": [
        {
          "$ref": "#/$defs/CursoreLotto"
        },
        {
          "type": "null"
        }
      ],
      "default": null
