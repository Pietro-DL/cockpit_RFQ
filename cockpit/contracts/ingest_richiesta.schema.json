        },
        "mittente_nome": {
          "default": "",
          "title": "Mittente Nome",
          "type": "string"
        },
        "mittente_indirizzo": {
          "default": "",
          "title": "Mittente Indirizzo",
          "type": "string"
        },
        "destinatari": {
          "items": {
            "$ref": "#/$defs/Destinatario"
          },
          "title": "Destinatari",
          "type": "array"
        },
        "oggetto": {
          "default": "",
          "title": "Oggetto",
          "type": "string"
        },
        "corpo_testo": {
          "default": "",
          "title": "Corpo Testo",
          "type": "string"
        },
        "corpo_html": {
          "default": "",
          "title": "Corpo Html",
          "type": "string"
        },
        "importanza": {
          "default": 1,
          "title": "Importanza",
          "type": "integer"
        },
        "non_letto": {
          "default": false,
          "title": "Non Letto",
          "type": "boolean"
        },
        "flag_stato": {
          "default": 0,
          "title": "Flag Stato",
          "type": "integer"
        },
        "categorie": {
          "items": {
            "type": "string"
          },
          "title": "Categorie",
          "type": "array"
        },
        "allegati": {
          "items": {
            "$ref": "#/$defs/AllegatoIn"
          },
          "title": "Allegati",
          "type": "array"
        },
        "marcatori": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Marcatori",
          "type": "object"
        }
      },
      "required": [
        "message_id",
        "entry_id",
        "cartella",
        "direzione",
        "data_evento"
      ],
      "title": "MessaggioIn",
      "type": "object"
    }
  },
  "properties": {
    "messaggi": {
      "items": {
