            "a",
            "cc",
            "ccn"
          ],
          "title": "Tipo",
          "type": "string"
        }
      },
      "title": "Destinatario",
      "type": "object"
    },
    "ElementoSaltato": {
      "description": "Elemento visto ma non convertito (com_error sul Body, elemento non-mail, ...). Non si butta:\nfinisce in scarto con origine 'lettura' e si rilegge con un job dedicato, perché il payload\ncompleto qui non c'è.",
      "properties": {
        "entry_id": {
          "title": "Entry Id",
          "type": "string"
        },
        "cartella": {
          "default": "",
          "title": "Cartella",
          "type": "string"
        },
        "message_id": {
          "default": "",
          "title": "Message Id",
          "type": "string"
        },
        "ricevuto_il": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ricevuto Il"
        },
        "oggetto": {
          "default": "",
          "title": "Oggetto",
          "type": "string"
        },
        "errore": {
          "title": "Errore",
          "type": "string"
        }
      },
      "required": [
        "entry_id",
        "errore"
      ],
      "title": "ElementoSaltato",
      "type": "object"
    },
    "MessaggioIn": {
      "description": "Un elemento Outlook letto via COM. Identità = message_id (Internet Message-ID), non entry_id.",
      "properties": {
        "message_id": {
          "title": "Message Id",
          "type": "string"
        },
        "parent_message_id": {
          "default": "",
          "title": "Parent Message Id",
          "type": "string"
        },
        "entry_id": {
          "title": "Entry Id",
          "type": "string"
        },
        "store_id": {
          "default": "",
          "title": "Store Id",
          "type": "string"
        },
        "conversation_id": {
          "default": "",
          "title": "Conversation Id",
          "type": "string"
        },
        "conversation_index": {
          "default": "",
          "title": "Conversation Index",
          "type": "string"
        },
        "in_reply_to": {
          "default": "",
          "title": "In Reply To",
          "type": "string"
        },
        "riferimenti": {
          "items": {
            "type": "string"
