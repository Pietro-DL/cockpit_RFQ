          "type": "string"
        },
        "content_type": {
          "default": "",
          "title": "Content Type",
          "type": "string"
        },
        "natura": {
          "default": "file",
          "enum": [
            "file",
            "inline",
            "elemento_outlook",
            "collegamento"
          ],
          "title": "Natura",
          "type": "string"
        },
        "bytes": {
          "default": 0,
          "title": "Bytes",
          "type": "integer"
