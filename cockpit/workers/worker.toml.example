# Configurazione di esempio per i worker Cockpit RFQ (worker_outlook e worker_analisi).
#
# NON SERVE COMPILARLO A MANO. Dalla pagina *Postazioni* del Cockpit si scarica il pacchetto di
# questo PC: contiene un worker.toml già pronto — indirizzo del server, impronta del certificato e i
# token dei worker di questa postazione — più i file del worker presi dal server, così la versione
# del worker e quella del server non si allontanano. Questo esempio serve a capire che cosa c'è
# dentro, e a compilarlo a mano quando serve (banco di prova).
#
# Copiare in worker.toml.
#
# ============================================================================
# COME SI PARTE su un PC
# ============================================================================
#
#  1. Sul Cockpit, pagina *Postazioni* → «genera e scarica il pacchetto» di QUESTO PC.
#  2. Scompattare lo zip in `workers\`, sovrascrivendo worker.toml. Dentro ci sono già server_url,
#     l'impronta del certificato e un token diverso per ogni worker di questo PC.
#  3. Controllare che `staging` punti a una cartella che esiste SU QUESTO PC (è la cartella del
#     worker: file temporanei e log, non lo staging del server).
#  4. Prova senza prendere job:   python worker_outlook.py --caselle
#     Deve elencare SOLO le caselle che il server assegna a questo PC.
#  5. Avvio:                      python worker_outlook.py
#                                 python worker_analisi.py   (se serve anche su questo PC)
#
# Se il worker si ferma dicendo «token mancante», il pacchetto non è mai stato scaricato o è stato
# scompattato altrove. Se invece riceve 401, il token di questo file non è più quello del server —
# di solito perché il pacchetto è stato rigenerato: se ne scarica uno nuovo. Dal blocco 2 il log del
# worker distingue i casi: un 401 dice «credenziale rifiutata» e non «server non raggiungibile».

server_url     = "http://127.0.0.1:8080"
# server_url   = "https://cockpit.azienda:8443"
#
# IMPRONTA (voce 2.4). Lo sha256 del certificato del server: il worker parla SOLO con chi presenta
# quel certificato, e si ferma con un errore esplicito se ne trova un altro. Si legge nel log
# dell'avvio del server e nella pagina Postazioni; con `server_url` https è ciò che sostituisce la
# verifica di una CA, che qui non esiste. Non toglierla per far ripartire un worker fermo: senza, non
# si sa più con chi si sta parlando.
# impronta     = "a1b2...64 caratteri esadecimali"
#
# TOKEN. Dal blocco 2 ogni worker ha il SUO: il server lo cerca per sha256 e da lì sa chi sta
# chiamando. Sullo stesso PC girano due worker, quindi i token sono due e stanno nelle tabelle in
# fondo a questo file ([outlook] e [analisi]). La riga qui sotto resta letta per compatibilità, ma
# due worker con lo stesso token ricevono 401: non identifica nessuno.
token          = ""
# Cartella locale DEL WORKER: file temporanei (l'allegato salvato da Outlook, il tempo di caricarlo al
# server con PUT) e il log. Non deve coincidere con [nas].staging del server: il worker può stare su
# un altro PC.
staging        = '..\_staging'
consenti_invio = false

# Nome del worker: deve coincidere con [[worker]].nome di cockpit.toml, perché è la chiave con cui il
# server riconosce credenziale, postazione e caselle autorizzate. Se manca, il worker usa
# "<tipo>@<NOME-HOST>", che è la forma attesa. Non contiene il PID: deve restare uguale fra i riavvii.
# Un nome non censito riceve 403 al claim; un worker il cui nome host non è la postazione della sua
# credenziale riceve 403 anche lui (worker.toml copiato su un altro PC).
# worker_id = "outlook@PC-NOME"

# Le caselle da servire NON si configurano qui: il worker le chiede al server (quelle autorizzate alla
# sua credenziale) e le risolve nel profilo Outlook di questo PC. Ogni quanti secondi rifare la
# risoluzione (una cassetta aggiunta al profilo viene vista senza riavviare). Default 300.
# risolvi_caselle_ogni_s = 300

# ------------------------------------------------------------------ finestra temporale (voce 2.9)
# Il sync chiede a Outlook solo la finestra che gli serve, con un filtro DASL in UTC (`Restrict`),
# invece di scorrere tutta la cartella all'indietro. Su una casella con 20 000 elementi è la
# differenza fra un secondo e due minuti.
#
# Prima di fidarsene, il worker lo PROVA: la prima volta che legge una cartella confronta gli insiemi
# di EntryID trovati con il filtro e trovati scorrendo tutto. Se il filtro ne perde anche uno solo, lo
# spegne per quella cartella e continua con la scansione lineare — più lenta, ma completa. L'esito è
# nel log del worker.
#
# usa_restrict = false lascia solo la scansione lineare: la via d'uscita se un profilo si comportasse
# in un modo che il self-test non prevede. Meglio lento che incompleto.
# usa_restrict = true
# Su quanti giorni fare la prova (0 = su tutta la finestra, cioè lento quanto ciò che vuole evitare).
# autoprova_restrict_giorni = 7
#
# Per eseguire la prova a mano, senza prendere job:  python worker_outlook.py --restrict 7
# Serve i nomi delle cartelle: se non sono quelli predefiniti, dichiararli qui.
# cartelle = ["Posta in arrivo", "Posta inviata"]

# ------------------------------------------------------------------ un token per worker (voce 2.4)
# Sullo stesso PC girano due worker e ognuno ha la sua credenziale. Le chiavi qui sotto vincono su
# quelle in cima al file: `worker_id` è la chiave con cui il server riconosce postazione e caselle
# autorizzate, `token` è il segreto di QUEL worker.
#
# [outlook]
# worker_id = "outlook@PC-NOME"
# token     = "..."
#
# [analisi]
# worker_id = "analisi@PC-NOME"
# token     = "..."
